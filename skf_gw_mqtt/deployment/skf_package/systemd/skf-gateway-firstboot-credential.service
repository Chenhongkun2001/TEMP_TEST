[Unit]
Description=SKF Gateway Per-Device Credential Provisioning
After=local-fs.target
Before=ssh.service
Before=sshd.service
Before=skf-gateway.target
 
ConditionPathExists=!/var/lib/skf-gateway/provision/credentials.initialized
 
[Service]
Type=oneshot
User=root
Group=root
 
ExecStart=/usr/libexec/skf-gateway/provision-credentials.sh
 
RemainAfterExit=yes
 
[Install]
WantedBy=multi-user.target
