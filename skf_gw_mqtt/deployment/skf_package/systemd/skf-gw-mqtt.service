[Unit]
Description=SKF Gateway MQTT Service
 
PartOf=skf-gateway.target
 
# mqtt_op must be managed only through skf-gateway.target.
# Prevent old scripts / accidental direct systemctl stop from
# leaving the cloud connection permanently offline.
RefuseManualStop=yes
 
Wants=skf-gw.service
Wants=skf-gw-sql.service
Wants=skf-gw-network-recovery.path
Wants=network-online.target
 
After=skf-gw.service
After=skf-gw-sql.service
After=skf-gw-network-recovery.path
After=network-online.target
 
[Service]
Type=simple
 
User=skfgw
Group=skfgw
 
WorkingDirectory=/var/lib/skf-gateway
Environment=HOME=/var/lib/skf-gateway
 
ExecStart=/opt/skf-gateway/bin/mqtt_op
 
Restart=always
RestartSec=5
 
UMask=0077
NoNewPrivileges=true
 
[Install]
WantedBy=skf-gateway.target
